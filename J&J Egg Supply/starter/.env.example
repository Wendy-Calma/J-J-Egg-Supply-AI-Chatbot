# Copy this file to .env and fill in real values. Never commit the real .env file.

# Gemini API key from Google AI Studio (aistudio.google.com -> Get API key).
GEMINI_API_KEY=paste-gemini-api-key-here
# Optional: model and thinking level (low/medium/high). Low = fastest replies.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_EFFORT=low
# Optional: tried in order (comma-separated) when the main model is busy.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash

# Optional: staff number shown when the bot can't help. Defaults to the
# number in kb/ordering.json.
STAFF_CONTACT=

# Optional: SQLite file for chat history and orders.
DB_PATH=jj_egg.db

# Any random string you choose yourself -- you'll type this same value
# into the Meta Developer Console webhook setup screen.
MESSENGER_VERIFY_TOKEN=choose-a-random-string

# From Meta Developer Console -> your app -> Messenger -> Page Access Token
# (only available once J&J has granted your team a Page role, see SRS section 2.1)
PAGE_ACCESS_TOKEN=paste-page-access-token-here

# Required: "Publish to web" CSV link of the Google Sheet with products,
# prices, and stock. See "Updating prices and stock" in README.md.
PRICING_SHEET_CSV_URL=

# Optional: Apps Script web app (sheet_script.gs) for live reads and automatic
# stock updates when an order is saved. See "Automatic stock updates" in README.md.
SHEET_SCRIPT_URL=
SHEET_SCRIPT_SECRET=

# Optional, defaults to 5000 locally. Render/Railway set this automatically.
PORT=5000

# Optional: 1 = auto-reload when app.py changes (local testing only).
FLASK_DEBUG=0
